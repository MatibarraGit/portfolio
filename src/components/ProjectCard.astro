---
interface Props {
  slug: string;
  title: string;
  description: string;
  tag: string;
  stack: string[];
  image: string;
  imageAlt: string;
  imageWide?: string;
  featured?: boolean;
}

const {
  slug,
  title,
  description,
  tag,
  stack,
  image,
  imageAlt,
  imageWide,
  featured = false,
} = Astro.props;

const cover = featured && imageWide ? imageWide : image;
---

<article class:list={["card", featured && "md:col-span-2 lg:grid lg:min-h-64 lg:grid-cols-2 lg:items-stretch"]}>
  <div class:list={["relative", featured && "lg:order-2"]}>
    <img
      src={cover}
      alt={imageAlt}
      width="1280"
      height="720"
      loading="lazy"
      class:list={[
        "w-full object-cover",
        featured ? "aspect-video lg:h-full lg:aspect-auto" : "aspect-video",
      ]}
    />
    <span class="badge absolute top-3 left-3">{tag}</span>
  </div>

  <div class:list={["flex flex-1 flex-col gap-3 p-5 sm:p-6", featured && "lg:order-1 lg:justify-center"]}>
    <h3 class="text-lg font-bold text-accent sm:text-xl">
      <a href={`/proyectos/${slug}`} class="card-link">{title}</a>
    </h3>

    <p class="text-sm leading-relaxed text-muted sm:text-base">{description}</p>

    <ul class="mt-auto flex flex-wrap gap-2 pt-2">
      {stack.map((tech) => <li class="chip">{tech}</li>)}
    </ul>
  </div>
</article>
