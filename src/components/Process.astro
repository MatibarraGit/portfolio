---
import { PROCESS_NOTES, PROCESS_SECTION, PROCESS_STEPS } from "../data/process";
import Icon from "./Icon.astro";
---

<section id={PROCESS_SECTION.id} class="shell scroll-mt-header py-16 sm:py-20 lg:py-24">
  <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl lg:text-4xl">
    {PROCESS_SECTION.title}
  </h2>

  <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted sm:mt-4 sm:text-base">
    {PROCESS_SECTION.intro}
  </p>

  <div class="mt-10 grid gap-10 lg:mt-12 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12">
    <ol class="min-w-0">
      {
        PROCESS_STEPS.map((step, i) => (
          <li class="process-step">
            <span class="process-marker" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>

            <div class="flex min-h-10 flex-wrap items-center gap-x-3 gap-y-2">
              <h3 class="text-base font-bold text-ink sm:text-lg">{step.title}</h3>
              <span class="process-timing">{step.timing}</span>
            </div>

            <p class="mt-2 max-w-prose text-sm leading-relaxed text-muted sm:text-base">
              {step.description}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="flex flex-col gap-4 sm:flex-row lg:flex-col">
      {
        PROCESS_NOTES.map((note) => (
          <div class="surface-panel flex-1 p-5 sm:p-6 lg:flex-none">
            <h3 class="flex items-center gap-2 text-sm font-bold text-ink sm:text-base">
              <Icon name={note.icon} class="size-5 text-accent" />
              {note.title}
            </h3>

            <ul class="mt-3 flex flex-col gap-2">
              {note.items.map((item) => (
                <li class="flex gap-2 text-sm leading-relaxed text-muted">
                  <span class="mt-2 size-1 shrink-0 rounded-full bg-accent-2" aria-hidden="true" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
