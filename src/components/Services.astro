---
import { SERVICES, SERVICES_SECTION } from "../data/services";
import ServiceCard from "./ServiceCard.astro";
---

<section id={SERVICES_SECTION.id} class="shell scroll-mt-header py-16 sm:py-20 lg:py-24">
  <h2 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl lg:text-4xl">
    {SERVICES_SECTION.title}
  </h2>

  <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted sm:mt-4 sm:text-base">
    {SERVICES_SECTION.intro}
  </p>

  <div class="mt-8 grid gap-4 sm:mt-10 sm:gap-6 md:grid-cols-2">
    {
      SERVICES.map((service, i) => (
        <ServiceCard
          icon={service.icon}
          title={service.title}
          description={service.description}
          index={i}
        />
      ))
    }
  </div>
</section>
