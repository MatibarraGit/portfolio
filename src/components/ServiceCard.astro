---
import type { IconName } from "../types";
import Icon from "./Icon.astro";

interface Props {
  icon: IconName;
  title: string;
  description: string;
  index: number;
}

const { icon, title, description, index } = Astro.props;

const number = String(index + 1).padStart(2, "0");
---

<article class="service-card">
  <div class="flex items-center justify-between gap-4">
    <span class="service-icon">
      <Icon name={icon} class="size-6" />
    </span>

    <span class="service-index" aria-hidden="true">{number}</span>
  </div>

  <h3 class="text-base font-bold text-ink sm:text-lg">{title}</h3>

  <p class="text-sm leading-relaxed text-muted sm:text-base">{description}</p>
</article>
